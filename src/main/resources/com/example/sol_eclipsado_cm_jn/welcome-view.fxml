<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.sol_eclipsado_cm_jn.controller.WelcomeController"
      alignment="CENTER"
      spacing="16"
      prefWidth="420"
      prefHeight="260">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <children>

        <ImageView fitWidth="450.0" preserveRatio="true">
            <image>
                <Image url="@images/fondo.png" />
            </image>
        </ImageView>

        <Label text="Ingresa la palabra secreta para iniciar el juego."
               wrapText="true"
               style="-fx-font-size: 14px;" />

        <TextField fx:id="secretWordTextField"
                   promptText="Escribe la palabra secreta"
                   maxWidth="250" />

        <Button text="Comenzar"
                onAction="#onHandleStartButton"
                maxWidth="140" />

        <Label fx:id="feedbackLabel"
               text=""
               wrapText="true"
               style="-fx-font-size: 13px;" />
    </children>
</VBox>